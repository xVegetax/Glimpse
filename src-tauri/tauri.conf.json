{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glimpse",
  "version": "1.0.0",
  "identifier": "com.glimpse.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Glimpse",
        "width": 540,
        "height": 100,
        "minWidth": 100,
        "minHeight": 40,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "maximizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Glimpse",
    "shortDescription": "Capture, Annotate & Share Instantly",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "both",
        "installerIcon": "icons/icon.ico",
        "languages": ["French", "English", "Spanish", "Italian", "German"],
        "displayLanguageSelector": true
      }
    }
  }
}
